// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - linked to Clerk auth
model User {
  id            String     @id @default(cuid())
  clerkId       String     @unique
  email         String     @unique
  firstName     String?
  middleName    String?
  lastName      String?
  phone         String?
  city          String?
  state         String?
  country       String?
  avatarUrl     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Onboarding completion flag
  onboardingCompleted Boolean   @default(false)

  // Relations
  resumes       Resume[]
  applications  Application[]
  apiKeys       ApiKey[]
  subscriptions Subscription[]
}

// Resume model
model Resume {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fileName      String
  fileUrl       String
  fileSize      Int
  
  // Parsed resume data (latest version)
  parsedData    Json?      // Structured resume data (skills, experience, education arrays)
  
  isDefault     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Relations
  versions      ResumeVersion[]
  applications  Application[]

  @@index([userId])
}

// Resume version history - never overwrite, always version
model ResumeVersion {
  id            String     @id @default(cuid())
  resumeId      String
  resume        Resume     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  // Original file data
  originalText  String     // Raw extracted text from file
  parsedData    Json       // Parsed structured data at time of upload
  
  // Metadata
  parsingEngine String     // "pdf2json-v1", "mammoth-v1", etc. for tracking improvements
  version       Int        @default(1)
  
  createdAt     DateTime   @default(now())

  @@index([resumeId])
  @@index([createdAt])
}

// Job Application model
model Application {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeId        String
  resume          Resume     @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  jobUrl          String
  companyName     String
  jobTitle        String
  jobDescription  String?
  
  autofillData    Json?      // Autofill responses
  answers         Json?      // AI-generated answers
  
  status          String     @default("draft") // draft, submitted, rejected, accepted
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([resumeId])
  @@unique([userId, jobUrl]) // Prevent duplicate applications to the same job
}

// API Key model - for extension authentication
model ApiKey {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  key           String     @unique @default(cuid()) // Random key
  name          String     @default("Extension Key")
  isActive      Boolean    @default(true)
  
  lastUsedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
  @@index([key])
}

// Subscription model for Stripe
model Subscription {
  id                    String     @id @default(cuid())
  userId                String
  user                  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  stripeSubscriptionId  String     @unique
  stripeCustomerId      String
  status                String     // active, canceled, past_due, incomplete, etc.
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  planId                String     // e.g., 'monthly', 'quarterly', 'yearly'
  priceId               String     // Stripe price ID
  currency              String     @default("usd")
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@index([stripeSubscriptionId])
  @@index([status])
}
